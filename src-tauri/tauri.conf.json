{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SoundWave",
  "version": "1.0.0",
  "identifier": "com.soundwave.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SoundWave",
        "width": 1024,
        "height": 720,
        "minWidth": 720,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["Russian"],
        "displayLanguageSelector": false
      }
    }
  }
}
